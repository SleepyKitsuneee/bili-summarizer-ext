{
  "manifest_version": 3,
  "name": "B站视频总结助手（本地版）",
  "version": "0.6.1",
  "description": "给链接就出总结：360P+64K 下载 → 本地 ffmpeg.wasm 合流 → 后台静默上传千问 → omni 模型结构化总结。全程本地处理视频，使用你自己的千问登录态。",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "declarativeNetRequestWithHostAccess",
    "offscreen",
    "scripting",
    "tabs",
    "debugger"
  ],
  "host_permissions": [
    "https://www.bilibili.com/*",
    "https://bilibili.com/*",
    "https://api.bilibili.com/*",
    "https://*.bilivideo.cn/*",
    "https://*.bilivideo.com/*",
    "https://chat.qwen.ai/*",
    "https://*.qwen.ai/*",
    "https://*.qwenlm.ai/*",
    "https://*.aliyuncs.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开 B站视频总结",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "options_page": "sidepanel/index.html",
  "content_scripts": [
    {
      "matches": [
        "https://chat.qwen.ai/*"
      ],
      "js": [
        "content/qwen-main-patch.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chat.qwen.ai/*"
      ],
      "js": [
        "content/qwen-driver.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
